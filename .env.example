# ReconX Environment Configuration

# Application
PROJECT_NAME="ReconX"
SECRET_KEY="your-super-secret-key-here"

# Database (Default: SQLite for zero configuration, easily switch to PostgreSQL)
DATABASE_URL="sqlite:///./reconx.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/reconx"

# Financial Tolerances
AMOUNT_TOLERANCE=0.01      # Inward rounding tolerance (e.g. <= ₹0.01)
DATE_WINDOW_DAYS=3         # Allowable days delta between gateway authorization and bank value date
DEFAULT_GST_RATE=0.18      # 18% GST on payment gateway fees

# AI Intelligence Layer (Optional - built-in deterministic synthesizer is active if key is not provided)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
